APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_gateway
POSTGRES_USER=telegram_gateway
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

NATS_URL=nats://nats:4222

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=telegram-gateway
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_USE_SSL=false
MINIO_BUCKET=telegram-media

# Operator-supplied Telegram application credentials; never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Public MCP is off unless an external OAuth/OIDC issuer is configured.
# This service is an OAuth resource server, not a password/login provider.
MCP_ENABLED=false
MCP_PUBLIC_URL=https://gateway.example.com/mcp
OAUTH_ISSUER=https://identity.example.com/realms/gateway
OAUTH_INTROSPECTION_CLIENT_ID=gateway-resource-server
# Prefer an owner-only secret file outside git; do not put tokens/OTPs in URLs.
OAUTH_INTROSPECTION_SECRET_FILE=
OAUTH_INTROSPECTION_SECRET=
MCP_ALLOWED_ORIGINS=
