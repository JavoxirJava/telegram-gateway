APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=10s

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_gateway
POSTGRES_USER=telegram_gateway
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

NATS_URL=nats://nats:4222

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=telegram-gateway
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_USE_SSL=false
MINIO_BUCKET=telegram-media

# Your own Telegram application credentials from https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Runtime administration and encrypted Telegram sessions (generate locally).
PUBLIC_URL=http://127.0.0.1:8086
GATEWAY_ADMIN_TOKEN=
TELEGRAM_SESSION_KEY=
TDLIB_DATA_DIR=/data/tdlib
