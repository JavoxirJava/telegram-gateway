# Instance name is the validated gateway account UUID; one process per account.
[Unit]
Description=Telegram Gateway account agent %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10
[Service]
Type=simple
User=telegram-gateway
Group=telegram-gateway
EnvironmentFile=/etc/telegram-gateway/agent.env
WorkingDirectory=/opt/telegram-gateway
ExecStart=/opt/telegram-gateway/tdlib-agent --account=%i --sessions-root=/var/lib/telegram-gateway/sessions --library=/opt/tdlib/lib/libtdjson.so --master-key-file=/etc/telegram-gateway/master.key --enable-live-mirror
Restart=on-failure
RestartSec=30
TimeoutStopSec=40
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telegram-gateway
LimitCORE=0
[Install]
WantedBy=multi-user.target
