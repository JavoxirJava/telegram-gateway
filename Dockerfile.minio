# Build the exact upstream release used by this project. Its former public
# container registries no longer serve the image. MinIO is licensed AGPL-3.0.
# Source: https://github.com/minio/minio/tree/07c3a429bfed433e49018cb0f78a52145d4bedeb
FROM docker.io/library/golang:1.27.1-bookworm AS builder
RUN GOBIN=/out CGO_ENABLED=0 go install github.com/minio/minio@v0.0.0-20250907161309-07c3a429bfed
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="07c3a429bfed433e49018cb0f78a52145d4bedeb" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY --from=builder /out/minio /usr/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data"]
